{
  "name": "bb-plugin-gh-copilot",
  "version": "1.0.0",
  "description": "Adds GitHub Copilot CLI to bb as an ACP coding-agent provider.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "bb",
    "bb-plugin",
    "acp",
    "coding-agent",
    "copilot"
  ],
  "homepage": "https://github.com/ai-ecoverse/bb-gh-copilot#readme",
  "bugs": {
    "url": "https://github.com/ai-ecoverse/bb-gh-copilot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/bb-gh-copilot.git"
  },
  "engines": {
    "bb": ">=0.40",
    "bbPluginSdk": ">=0.4.94"
  },
  "bb": {
    "name": "GitHub Copilot",
    "description": "Adds GitHub Copilot CLI to bb as an ACP coding-agent provider.",
    "branding": {
      "icon": "./assets/logo.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "scripts": {
    "prepare": "slicc-install-hooks",
    "build": "bb plugin build .",
    "test": "node --test 'test/integration/*.test.mjs'",
    "test:unit": "NODE_NO_WARNINGS=1 mcr -c node_modules/@ai-ecoverse/slicc-shared-web/mcr.config.mjs node --test 'test/unit/**/*.test.mjs'",
    "typecheck": "tsc",
    "lint": "slicc-lint",
    "format": "biome check --write .",
    "release": "semantic-release"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-shared-web": "2.14.2",
    "@biomejs/biome": "2.6.7",
    "@get-bb/plugin-sdk": "0.6.140",
    "@pierre/diffs": "1.6.4",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-hover-card": "1.2.1",
    "@radix-ui/react-menubar": "1.2.1",
    "@radix-ui/react-navigation-menu": "1.4.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@semantic-release/git": "11.0.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "better-sqlite3": "13.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.18",
    "lefthook": "2.2.2",
    "monocart-coverage-reports": "3.2.0",
    "semantic-release": "25.0.9",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "typescript": "7.0.2",
    "vaul": "1.1.2"
  }
}
